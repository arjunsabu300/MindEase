{
  "expo": {
    "name": "MindEase",
    "slug": "mindease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mindease-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mindease-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow MindEase to access your camera for emotion detection and yoga posture checking.",
        "NSMicrophoneUsageDescription": "Allow MindEase to access your microphone for voice sentiment analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mindease-logo.png",
        "backgroundColor": "#667eea"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mindease.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MindEase to access your camera for emotion detection and yoga posture checking."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e9f15338-fdba-4288-89eb-4163f0139479"
      }
    }
  }
}
